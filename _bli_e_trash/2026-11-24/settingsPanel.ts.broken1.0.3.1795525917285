/**
 * 「设置面板缩放」滑块挂在哪个分类下（分组名取自 features.ts 的 group）。
 * 它不是一个功能开关，所以单独渲染、单独接线。
 */
const SCALE_GROUP = '界面优化'
/** 「实验室」：实验性功能，单独一页，页面顶部有一句说明（见 labNoteHtml） */
