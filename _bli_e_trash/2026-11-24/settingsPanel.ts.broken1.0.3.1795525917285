/**
 * 「开源地址」：面板末尾的静态页，不来自 features.ts（没有开关、没有参数），
 * 所以导航项与页面都单独拼一段。两个链接都是 <a target="_blank">，
 * 交给浏览器开新标签 —— 内容脚本里 window.open 容易被弹窗拦截。
 */
const ABOUT_GROUP = '开源地址'
const ABOUT_LINKS = [
